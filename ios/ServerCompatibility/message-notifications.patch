+
+@SpringBootTest(classes=HelloServiceApplication.class,properties={
+    "spring.datasource.url=jdbc:h2:mem:chat-push;DB_CLOSE_DELAY=-1","spring.jpa.hibernate.ddl-auto=create-drop",
